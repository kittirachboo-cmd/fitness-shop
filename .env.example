# -------------------------------------------------------------
# FITGEAR / IRONPULSE FITNESS - Environment Variables
# คัดลอกไฟล์นี้ไปเป็น .env.local แล้วกรอกค่าตามจริง
# -------------------------------------------------------------

# 1. Supabase (https://supabase.com)
# ไปที่ Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. พร้อมเพย์ (PromptPay)
# เบอร์โทรศัพท์ 10 หลัก (เช่น 0812345678) หรือเลขบัตรประชาชน 13 หลัก
PROMPTPAY_ID=0812345678
SHOP_BANK_NAME=ธนาคารกสิกรไทย (KBANK)
SHOP_BANK_ACCOUNT=123-4-56789-0
SHOP_ACCOUNT_NAME=บจก. ไอรอนฟิต สปอร์ตส์

# 3. Google Sheets Integration (Google Apps Script)
# ดูวิธีรับ URL และตั้งรหัสในโฟลเดอร์ google-sheet/Code.gs
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/AKfycb.../exec
GOOGLE_SHEET_SECRET=your_super_secret_webhook_key_2026_fitness

# 4. อีเมลเจ้าของร้านสำหรับรับแจ้งเตือน
OWNER_NOTIFY_EMAIL=kittirach.boo@tsn.thai-tech.ac.th

# 5. ข้อมูลร้านค้าทั่วไป
NEXT_PUBLIC_STORE_NAME=IRONPULSE FITNESS
NEXT_PUBLIC_STORE_PHONE=089-123-4567
NEXT_PUBLIC_STORE_LINE=@ironfit
NEXT_PUBLIC_APP_URL=http://localhost:3000
